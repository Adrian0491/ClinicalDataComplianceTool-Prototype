# =============================================================================
# gcloud builds submit — source upload exclusions
#
# Deliberately NOT based on .gitignore: that file's unanchored `storage/`
# pattern (meant to exclude the root-level runtime upload dir) also matches
# backend/app/storage/, which is real tracked source code. Listing exclusions
# explicitly here avoids silently dropping source files from manual
# `gcloud builds submit` uploads.
# =============================================================================

.git/
.gitignore

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

frontend/node_modules/
frontend/dist/
frontend/.angular/

landing/screenshots/node_modules/

logs/
output/

# Root-level runtime upload storage — NOT backend/app/storage (source code)
/storage/

.terraform/
*.tfstate
*.tfstate.backup
